# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit your real credentials.

# Groq API key — get one at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Tuya smart bulb credentials — find these in the Tuya / Smart Life app
TUYA_DEVICE_ID=your-device-id
TUYA_IP_ADDRESS=192.168.x.xxx
TUYA_LOCAL_KEY=your-local-key
